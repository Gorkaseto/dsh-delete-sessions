{
  "name": "dsh-delete-sessions",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "gorkaseto",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gorkaseto/dsh-delete-sessions.git"
  },
  "homepage": "https://github.com/Gorkaseto/dsh-delete-sessions#readme",
  "description": "Adds a \"Delete session\" option to the sidebar session menu that permanently removes the session",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "NOTICE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
